# ─────────────────────────────────────────────────────────────
#  ExamHub environment configuration
#  Copy to `.env` and adjust. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# local | production
APP_ENV=local

# Show detailed errors in the browser. MUST be false in production.
APP_DEBUG=true

# Absolute base URL. Leave empty to auto-detect (recommended for XAMPP).
# Set explicitly in production, e.g. https://exams.example.com
APP_URL=

# Human-readable application name, used in page titles.
APP_NAME=ExamHub

# Enable ONLY when the app sits behind a reverse proxy that sets
# X-Forwarded-Proto and strips any copy the client sent. Left false, the
# header is ignored so a client cannot claim its connection was secure.
APP_TRUST_PROXY=false

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_exam_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── Session ─────────────────────────────────────────────────
SESSION_NAME=examhub_session
# Random 32+ char string, unique per environment. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=change-me-to-a-long-random-string
# Force the Secure cookie flag (auto-enabled when HTTPS is detected).
SESSION_SECURE=false
# Sign out after this many seconds without a request (default 30 minutes).
SESSION_IDLE_TIMEOUT=1800
# Hard ceiling on a session's life in seconds, however active (default 8 h).
SESSION_ABSOLUTE_TIMEOUT=28800

# ── Account security ────────────────────────────────────────
# bcrypt work factor. Raise as hardware improves; 12 is ~250ms today.
BCRYPT_COST=12
# Minimum password length accepted at registration.
PASSWORD_MIN_LENGTH=8
# Failed sign-ins per identifier before a temporary lockout, and the length
# of both the counting window and the lockout, in seconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY=900

# ── Domain rules ────────────────────────────────────────────
# Percentage required to pass an exam.
EXAM_PASS_MARK=60
# Maximum allowed exam duration, in minutes.
EXAM_MAX_DURATION=300
# Seconds a submission may arrive late and still be graded. Past this, the
# attempt is recorded as expired and scores zero.
EXAM_SUBMIT_GRACE=60
